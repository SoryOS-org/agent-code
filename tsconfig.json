{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": ["vite/client"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@packages/*": [
        "./packages/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": [
    "dist",
    "packages/e2b/test",
    "packages/e2b/src/bootstrap.ts",
    "packages/e2b/src/workspace.ts",
    "packages/e2b/src/sandbox-store.ts",
    "packages/e2b/src/gc.ts",
    "packages/e2b/src/runtime.ts",
    "packages/e2b/src/template.ts",
    "packages/e2b/src/upload.ts",
    "packages/e2b/src/workspace-create.ts",
    "packages/e2b/src/e2b.ts",
    "packages/e2b/src/config.ts",
    "packages/e2b/src/config-validate.ts",
    "packages/e2b/src/e2b-sdk.ts",
    "packages/e2b/src/types.ts",
    "packages/e2b/src/shared.ts",
    "packages/e2b/src/local-git.ts",
    "packages/e2b/src/index.ts"
  ]
}
