# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENROUTER_API_KEY: Optional. For OpenRouter free models (llama 3.3 70b, deepseek-r1, qwen 2.5 coder).
# Obtain a free key without credit card at https://openrouter.ai/keys
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# EXA_API_KEY: Optional. For neural web search powered by Exa (exa.ai) as in OpenCode.
# If omitted, the web search tool automatically uses DuckDuckGo fallback search.
# Obtain a free key at https://exa.ai
EXA_API_KEY="MY_EXA_API_KEY"

# E2B_API_KEY: Required for the remote E2B sandbox where the agent executes
# commands and code (the agent's remote work environment).
# Obtain a free key at https://e2b.dev/dashboard
E2B_API_KEY="MY_E2B_API_KEY"

# E2B_PROJECT_PATH: Optional. Project path inside the sandbox. Default: /home/user/project
E2B_PROJECT_PATH="/home/user/project"

# E2B_SANDBOX_TIMEOUT_MS: Optional. Sandbox keep-alive timeout, re-extended
# at each tool call. Default: 3600000 (1 hour)
E2B_SANDBOX_TIMEOUT_MS="3600000"

